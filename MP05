#include <iostream>
#include <iomanip>
using namespace std;

// Function prototypes
void printAscendingRow(int k);
void printDescendingRow(int k);
void countdown(int n);
void printGridRow(int row, int col, int n);

void ascendingTriangle(int n);
void descendingTriangle(int n);
void multiplicationGrid(int n);
int getSize();

int main()
{
    int choice;
    int n;

    do
    {
        cout << "\n===== NUMBER PATTERN GENERATOR =====" << endl;
        cout << "1 - Ascending Triangle" << endl;
        cout << "2 - Descending Triangle" << endl;
        cout << "3 - Recursive Countdown" << endl;
        cout << "4 - Multiplication Grid" << endl;
        cout << "0 - Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                n = getSize();
                if (n != -1)
                {
                    cout << "\nAscending Triangle:" << endl;
                    ascendingTriangle(n);
                }
                break;

            case 2:
                n = getSize();
                if (n != -1)
                {
                    cout << "\nDescending Triangle:" << endl;
                    descendingTriangle(n);
                }
                break;

            case 3:
                n = getSize();
                if (n != -1)
                {
                    cout << "\nRecursive Countdown:" << endl;
                    countdown(n);
                    cout << "GO!" << endl;
                }
                break;

            case 4:
                n = getSize();
                if (n != -1)
                {
                    cout << "\nMultiplication Grid:" << endl;

                    multiplicationGrid(n);
                }
                break;

            case 0:
                cout << "\nProgram terminated. Goodbye!" << endl;
                break;

            default:
                cout << "\nInvalid choice! Please select from 0 to 4." << endl;
        }

    } while (choice != 0);

    return 0;
}

// Get and validate size
int getSize()
{
    int n;

    cout << "Enter size (1-9): ";
    cin >> n;

    if (cin.fail())
    {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Invalid input! Please enter a number from 1 to 9." << endl;
        return -1;
    }

    if (n < 1 || n > 9)
    {
        cout << "Invalid size! Please enter a value from 1 to 9." << endl;
        return -1;
    }

    return n;
}

// Recursively print ascending row
void printAscendingRow(int k)
{
    if (k == 0)
        return;

    printAscendingRow(k - 1);
    cout << k << " ";
}

// Recursively print descending row
void printDescendingRow(int k)
{
    if (k == 0)
        return;

    cout << k << " ";
    printDescendingRow(k - 1);
}

// Print ascending triangle using a loop
void ascendingTriangle(int n)
{
    for (int i = 1; i <= n; i++)
    {
        printAscendingRow(i);
        cout << endl;
    }
}

// Print descending triangle using a loop
void descendingTriangle(int n)
{
    for (int i = n; i >= 1; i--)
    {
        printAscendingRow(i);
        cout << endl;
    }
}

// Recursive countdown
void countdown(int n)
{
    if (n == 0)
        return;

    cout << n << " ";
    countdown(n - 1);
}

// Recursively print multiplication grid row
void printGridRow(int row, int col, int n)
{
    if (col > n)
        return;

    cout << setw(4) << row * col;
    printGridRow(row, col + 1, n);
}

// Print multiplication grid using a loop
void multiplicationGrid(int n)
{
    for (int row = 1; row <= n; row++)
    {
        printGridRow(row, 1, n);
        cout << endl;
    }
}
